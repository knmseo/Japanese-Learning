# Netlify serves .webmanifest as application/octet-stream by default, which is
# the wrong type for a web app manifest. Chrome tolerates it; Safari is stricter,
# and installability is the point of shipping one at all.
/manifest.webmanifest
  Content-Type: application/manifest+json; charset=utf-8

# The service worker must never be served stale, or the app can pin itself to an
# old version: the SW is what decides when to fetch a new build.
/sw.js
  Cache-Control: public, max-age=0, must-revalidate
